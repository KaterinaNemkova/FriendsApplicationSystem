{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire" : "Information"
    }
  },
  "AllowedHosts": "*",
  "Smtp" : {
    "Port": 465
  },
  "UserGrpcUrl":{
    "GrpcUrl" : "__USER_GRPC_URL__"
  },
  "JWTSettings":{
    "SecurityKey": "__JWT_SECURITY_KEY__",
    "Audience": "microservices",
    "Issuer": "authservice_api"
  },
  "ConnectionStrings": {
    "PostgresDB": "__POSTGRES_DB_CONNECTION_STRING__"
  }
}
