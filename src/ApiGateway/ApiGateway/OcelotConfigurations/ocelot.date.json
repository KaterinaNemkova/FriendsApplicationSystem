{
  "GlobalConfiguration": {
    "BaseUrl": null
  },
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/dates",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/dates",
      "UpstreamHttpMethod": [ "GET" ],
      "RouteClaimsRequirement": {
        "Role": "Admin"
      },
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/dates/new",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/dates/new",
      "UpstreamHttpMethod": [ "POST"],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/dates/{dateId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/dates/{dateId}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/dates/{dateId}/changes",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/dates/{dateId}/changes",
      "UpstreamHttpMethod": [ "PUT" ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/dates/my-dates",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/dates/my-dates",
      "UpstreamHttpMethod": [ "GET" ],
      "SwaggerKey": "Events"
    }
    
  ]
}