        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals",
      "UpstreamHttpMethod": [
        "POST"
      ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/goals/{goalId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals/{goalId}",
      "UpstreamHttpMethod": [
        "DELETE"
      ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/goals/{goalId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals/{goalId}",
      "UpstreamHttpMethod": [
        "PUT"
      ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/goals",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "RouteClaimsRequirement": {
