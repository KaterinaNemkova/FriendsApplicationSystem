      },
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/goals/my-goals",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals/my-goals",
      "UpstreamHttpMethod": [
        "GET"
      ],
      "SwaggerKey": "Events"
    },

    {
      "DownstreamPathTemplate": "/api/goals/done/{goalId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "eventsservice_api",
          "Port": 8080
        }
      ],
      "UpstreamPathTemplate": "/api/goals/done/{goalId}",
      "UpstreamHttpMethod": [
        "PUT"
      ],
      "SwaggerKey": "Events"
    }
    
  ]
